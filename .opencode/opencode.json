{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["superpowers", "superbased-opencode-plugin"],
  "mcp": {
    "superbased": {
      "type": "local",
      "command": ["superbased", "mcp"],
      "enabled": true,
      "env": {
        "SUPERBASED_MCP_TEXT_ONLY": "1"
      }
    }
  },
  "default_agent": "python-expert",
  "permission": {
    "skill": {
    }
  },
  "agent": {
    "python-expert": {
      "deny": ["rust-engineer", "tauri-sidecar", "tauri-websocket", "tauri-commands", "rust-patterns", "rust-testing", "python-backend", "python-fastapi", "python-tooling", "python-package-management", "python-type-hints"]
    },
    "rust-expert": {
      "deny": ["python-*"]
    },
    "html-expert": {
      "deny": ["python-*", "rust-engineer", "rust-patterns", "rust-testing", "tauri-sidecar", "tauri-websocket", "tauri-commands"]
    },
    "typescript-expert": {
      "deny": ["python-*", "rust-engineer", "rust-patterns", "rust-testing", "tauri-sidecar", "tauri-websocket", "tauri-commands"]
    },
    "planeador": {
      "deny": ["python-backend", "python-fastapi", "python-tooling", "python-package-management", "python-type-hints"]
    },
    "backend-expert": {
      "deny": ["python-audio", "python-whisper", "python-websocket-server", "audio-signal", "rust-engineer", "tauri-sidecar", "tauri-websocket", "tauri-commands", "websocket-protocol", "react-frontend", "typescript-core", "typescript-react", "html-core", "css-core", "yartis-ci-cd", "planeacion", "multiagent-orchestrator", "asistente-proactivo", "git-workflow"]
    }
  }
}
